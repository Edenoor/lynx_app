{
  "expo": {
    "name": "WynFlexFrontEnd",
    "slug": "WynFlexFrontEnd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE600"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beltrameme.wynflexfe",
      "config": {
        "googleMapsApiKey": "AIzaSyDU6WdF2MDI-zRym8Um4PctN5U_tjBmoeM"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.beltrameme.wynflexfe",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDU6WdF2MDI-zRym8Um4PctN5U_tjBmoeM"
        }
      },
      "permissions": [
        "CAMERA",
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "MLI_APP_ID": "4868503143760383",
      "MLI_REDIRECT_URI": "https://oauth.pstmn.io/v1/callback"
    }
  }
}

